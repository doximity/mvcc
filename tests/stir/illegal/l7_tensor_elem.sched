# L7: tensor-op engine on a stage that is not a contraction.
schedule synthetic_silu why=illegal-L7
  stage 0 engine=tensor-op exchange=none prefetch=at-use predicate=branch thread_scale=1 smem=0
    split c0_lane coord=0 size=256 bind=lane
    storage t0 device
    storage t1 device
    storage t2 device
