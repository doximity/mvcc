# L2: replicate a contribution the algebra does not grant duplicate for.
schedule synthetic_gemm why=illegal-L2
  stage 0 engine=scalar-fma exchange=shuffle-tree prefetch=at-use predicate=branch thread_scale=1 smem=0
    split c0_lane coord=0 size=32 bind=replicate
    split c1_lane coord=1 size=8 bind=lane
    split c2_k coord=2 size=* bind=time
    order c2_k
    storage t0 device
    storage t1 device
    storage t2 device
