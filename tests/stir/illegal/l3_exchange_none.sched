# L3: a reduction coordinate bound to a parallel axis with no exchange.
schedule synthetic_gemm why=illegal-L3
  stage 0 engine=scalar-fma exchange=none prefetch=at-use predicate=branch thread_scale=1 smem=0
    split c0_lane coord=0 size=32 bind=lane
    split c1_lane coord=1 size=8 bind=lane
    split c2_k coord=2 size=* bind=simdgroup
    order c2_k
    storage t0 device
    storage t1 device
    storage t2 device
